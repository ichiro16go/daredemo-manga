# --- Supabase (INFRA-3) ---
# `supabase start` で起動したローカルインスタンスの値、または本番プロジェクトの値
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI API (INFRA-5) ---
# Gemini Developer API のキー。キャラクター生成(F-02)等で使用
# 参照元: src/lib/ai/gemini.ts
GEMINI_API_KEY=

# ARK(Volcengine Ark)のAPIキー。背景生成(F-05)等で使用
# 参照元: src/lib/ai/ark.ts
ARK_API_KEY=
